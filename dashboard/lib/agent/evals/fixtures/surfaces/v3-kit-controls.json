    "variant": 3,
    "title": "Applications by stage, with the PR 5 kit controls",
    "html": "<h1>Your applications by stage</h1>\n<div class=\"jb-stack\">\n<div class=\"jb-row\">\n<jb-select name=\"stage\" label=\"Stage\" value=\"all\"><option value=\"all\">All stages</option><option value=\"applied\">Applied</option><option value=\"interviewing\">Interviewing</option></jb-select>\n<jb-segmented name=\"range\" label=\"Range\" value=\"month\"><option value=\"week\">Week</option><option value=\"month\">Month</option></jb-segmented>\n<jb-toggle name=\"remote\" label=\"Remote only\"></jb-toggle>\n</div>\n<jb-slider name=\"weeks\" label=\"Weeks back\" min=\"1\" max=\"12\" value=\"4\"></jb-slider>\n<jb-tabs name=\"view\" label=\"Views\" value=\"0\"><jb-tab label=\"Summary\"><p>Applications by stage over the weeks shown.</p></jb-tab><jb-tab label=\"Notes\"><p>No notes yet.</p></jb-tab></jb-tabs>\n<div id=\"chart\"></div>\n<div id=\"table\"></div>\n<p class=\"jb-muted\">Picked: <span id=\"picked\">nothing yet</span></p>\n<jb-button variant=\"secondary\" action='{\"name\":\"open\",\"target\":\"applications\"}'>Open the tracker</jb-button>\n</div>\n<script>\nfunction show(text) { document.getElementById(\"picked\").textContent = text; }\nhost.onInit(function () {\n  host.chart(document.getElementById(\"chart\"), {\n    viz: \"bar\",\n    title: \"Applications by stage\",\n    points: [{ label: \"Applied\", value: 3 }, { label: \"Interviewing\", value: 2 }, { label: \"Offer\", value: 1 }],\n    onSelect: function (p) { show(p.label); }\n  });\n  host.table(document.getElementById(\"table\"), {\n    caption: \"Applications by stage\",\n    columns: [\n      { key: \"stage\", label: \"Stage\", sortable: true },\n      { key: \"count\", label: \"Applications\", align: \"end\", sortable: true }\n    ],\n    rows: [{ stage: \"Applied\", count: 3 }, { stage: \"Interviewing\", count: 2 }, { stage: \"Offer\", count: 1 }],\n    onRowSelect: function (row) { show(row.stage); }\n  });\n});\n</script>"
  }
